  fill linear (160, 40) (1040, 700) 0 #f6f0e2 0.48 #efe3d0 1 #e4d5c0;
  stroke #d5c9b6 width 1.15 cap round join round;
  move (640, 378); line (640, 218.85); line (566.79, 218.85); close;
};
