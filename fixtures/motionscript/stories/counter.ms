// STICK FIGHT — COUNTER
// 30 seconds. Cyan (left, quick) and Orange (right, relentless).
// 0:00 challenge, 0:03 three answers, 0:07 reversal, 0:11 pillar flip,
// 0:16 close combat, 0:21 feint, 0:25 final kick, 0:28 offer and cut.
scene "counter" {
  version "0.2";
  viewport (1280, 720);
  background #08090e;
  duration 30s;
};
camera main {
  position (640, 430);
  zoom 0.94;
  rotation 0deg;
};
rectangle floor {
  position (-500, 640);
  size (2400, 220);
  fill #10131c;
  zIndex 0;
};
line ground {
  from (-500, 640);
  to (1900, 640);
  stroke #3c4458 width 4;
  zIndex 1;
};
ellipse shadowCyan {
  position (300, 632);
  size (86, 18);
  fill #05060a;
  opacity 0.4;
  zIndex 2;
};
ellipse shadowOrange {
  position (980, 632);
  size (96, 20);
  fill #05060a;
  opacity 0.4;
  zIndex 2;
};
group pillar {
  position (1124, 210);
  pivot (24, 430);
  zIndex 6;
  rectangle shaft {
    size (48, 430);
    fill #3a4154;
  };
  rectangle edge {
    size (7, 430);
    fill #5c657a;
  };
  path crack {
    opacity 0;
    move (30, 36);
    line (16, 92);
    line (34, 148);
    line (18, 214);
    line (32, 268);
    stroke #e7e5e4 width 3 cap round join round;
  };
};
group cyan {
  position (300, 520);
  scale (1, 1);
  zIndex 12;
  group torso {
    group legRear {
      position (-11, 0);
      line bone { from (0, 0); to (0, 58); stroke #22d3ee width 9 cap round join round; };
      group shin {
        position (0, 58);
        line bone { from (0, 0); to (0, 56); stroke #22d3ee width 8 cap round join round; };
        group foot {
          position (0, 56);
          line bone { from (0, 0); to (0, 26); stroke #22d3ee width 7 cap round join round; };
        };
      };
    };
    group legLead {
      position (11, 0);
      line bone { from (0, 0); to (0, 58); stroke #22d3ee width 12 cap round join round; };
      group shin {
        position (0, 58);
        line bone { from (0, 0); to (0, 56); stroke #22d3ee width 11 cap round join round; };
        group foot {
          position (0, 56);
          line bone { from (0, 0); to (0, 26); stroke #22d3ee width 8 cap round join round; };
        };
      };
    };
    circle pelvis { radius 9; fill #22d3ee; };
    line spine { from (0, 8); to (0, -88); stroke #22d3ee width 16 cap round join round; };
    group armRear {
      position (-17, -72);
      line bone { from (0, 0); to (0, 52); stroke #22d3ee width 9 cap round join round; };
      group fore {
        position (0, 52);
        line bone { from (0, 0); to (0, 48); stroke #22d3ee width 8 cap round join round; };
        group hand {
          position (0, 48);
          circle fist { position (0, 8); radius 7.5; fill #22d3ee; };
        };
      };
    };
    group armLead {
      position (15, -72);
      line bone { from (0, 0); to (0, 52); stroke #22d3ee width 13 cap round join round; };
      group fore {
        position (0, 52);
        line bone { from (0, 0); to (0, 48); stroke #22d3ee width 12 cap round join round; };
        group hand {
          position (0, 48);
          circle fist { position (0, 8); radius 8.5; fill #22d3ee; };
          group fingers {
            position (0, 12);
            line one { from (0, 0); to (8, -11); stroke #22d3ee width 4 cap round join round; };
            line two { from (0, 0); to (12, -3); stroke #22d3ee width 4 cap round join round; };
          };
        };
      };
    };
    group head {
      position (0, -102);
      circle skull { radius 22; fill #22d3ee; };
      circle eye { position (9, -1); radius 3.5; fill #071018; };
      line nose { from (12, 2); to (21, 5); stroke #071018 width 3 cap round; };
      group brow {
        line mark { from (-1, -10); to (14, -7); stroke #071018 width 3.2 cap round; };
      };
      group jaw {
        line mouth { from (-8, 7); to (8, 7); stroke #071018 width 3 cap round; };
      };
    };
  };
};
