// PACKET JOURNEY
// 35 seconds. Dark schematic, cyan routes, violet packets, amber for loss and retransmission.
// 0:00 the message splits. 0:05 the routes diverge. Packet 3 dies on the lower link at 0:09.
// 0:11 packets 4, 2, then 1 land out of order. 0:18 packet 5 fills slot 5.
// 0:22 the timer expires and packet 3 is sent again on the middle route.
// 0:28 the buffer completes. 0:32 the line reads HELLO, NETWORK! and holds.
scene "packet-journey" {
  version "0.2";
  viewport (1280, 720);
  background #070b12;
  duration 35s;
  requires "easing.hold";
  requires "geometry.roundedRect";
  requires "text.basic";
};
camera main {
  position (330, 370);
  zoom 1.72;
  rotation 0deg;
};
group grid {
  zIndex 0;
  line v0 { from (120, 40); to (120, 820); stroke #162230 width 1; };
  line v1 { from (400, 40); to (400, 820); stroke #162230 width 1; };
  line v2 { from (680, 40); to (680, 820); stroke #162230 width 1; };
  line v3 { from (960, 40); to (960, 820); stroke #162230 width 1; };
  line v4 { from (1240, 40); to (1240, 820); stroke #162230 width 1; };
  line v5 { from (1520, 40); to (1520, 820); stroke #162230 width 1; };
  line v6 { from (1800, 40); to (1800, 820); stroke #162230 width 1; };
  line h0 { from (40, 120); to (1880, 120); stroke #162230 width 1; };
  line h1 { from (40, 280); to (1880, 280); stroke #162230 width 1; };
  line h2 { from (40, 440); to (1880, 440); stroke #162230 width 1; };
  line h3 { from (40, 600); to (1880, 600); stroke #162230 width 1; };
  line h4 { from (40, 760); to (1880, 760); stroke #162230 width 1; };
};
