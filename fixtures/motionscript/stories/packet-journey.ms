  text name { position (0, -26); content "SENDER"; fontFamily "sans"; fontSize 15; fontWeight 700; align center; baseline middle; fill #e7eef6;  };
  text kept { position (0, 2); content "NET"; fontFamily "sans"; fontSize 16; fontWeight 700; align center; baseline middle; fill #d4ccff; opacity 0; };
  text keptCap { position (0, 24); content "RETAINED"; fontFamily "sans"; fontSize 11; fontWeight 650; align center; baseline middle; fill #8b9bb0; opacity 0; };
  circle port { position (82, 0); radius 4; fill #3de0ff; };
};
