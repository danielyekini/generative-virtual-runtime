// CLOCKWORK
// 30 seconds. Precise ink on a warm sheet, with brass wheels and steel arbors.
// 0:00 reveal the exploded train. 0:07 assemble gears, axles and hands.
// 0:14 mesh. Adjacent wheels reverse. Rate follows tooth count.
// The red path runs from the barrel to the fourth wheel and its second hand.
// 0:20 the dial closes. 0:21 the view pulls back to the running clock.
scene "clockwork" {
  version "0.2";
  viewport (1280, 720);
  background #f3eadc;
  duration 30s;
  requires "easing.hold";
  requires "geometry.operators";
  requires "geometry.trimPath";
  requires "geometry.animatedTrim";
  requires "transform.parent";
  requires "text.basic";
};
camera main {
  position (640, 390);
  zoom 1;
  rotation 0deg;
};
rectangle sheetOuter {
  position (28, 22);
  size (1224, 676);
  stroke #241e18 width 1.4;
  zIndex 0;
};
rectangle sheetInner {
  position (40, 34);
  size (1200, 652);
  stroke #6e6256 width 0.7;
  zIndex 0;
};
rectangle titleBlock {
  position (58, 52);
  size (268, 210);
  stroke #241e18 width 1;
  zIndex 1;
};
line titleRule {
  from (58, 112);
  to (326, 112);
  stroke #241e18 width 0.8;
  zIndex 1;
};
text titleFig { position (70, 78); content "FIG. 1"; fontFamily "sans"; fontSize 20; fontWeight 700; fill #241e18; zIndex 1; };
text titleName { position (70, 100); content "EIGHT-DAY TRAIN"; fontFamily "sans"; fontSize 13; fontWeight 500; fill #241e18; zIndex 1; };
text titleMat { position (70, 132); content "BRASS AND STEEL"; fontFamily "sans"; fontSize 12; fontWeight 500; fill #6e6256; zIndex 1; };
text titlebarrel { position (70, 154); content "BARREL   18   CCW"; fontFamily "sans"; fontSize 12; fontWeight 500; fill #241e18; zIndex 1; };
text titlecentre { position (70, 170); content "CENTRE   14   CW"; fontFamily "sans"; fontSize 12; fontWeight 500; fill #241e18; zIndex 1; };
text titlethird { position (70, 186); content "THIRD   12   CCW"; fontFamily "sans"; fontSize 12; fontWeight 500; fill #241e18; zIndex 1; };
text titlefourth { position (70, 202); content "FOURTH   10   CW"; fontFamily "sans"; fontSize 12; fontWeight 500; fill #241e18; zIndex 1; };
text titleescape { position (70, 218); content "ESCAPE   9   CCW"; fontFamily "sans"; fontSize 12; fontWeight 500; fill #241e18; zIndex 1; };
text titleLaw { position (70, 242); content "RATE FOLLOWS TOOTH COUNT"; fontFamily "sans"; fontSize 11; fontWeight 500; fill #6e6256; zIndex 1; };
