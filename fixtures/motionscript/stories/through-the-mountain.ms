// THROUGH THE MOUNTAIN. 160 world px/s; wheel radius 12; three carriages at pitch 114.
// Silent story plate. Whistles/clatter/wind are brief cues, not supported audio.
scene "through-the-mountain" { version "0.2"; viewport (1280,720); background #c9e3ed; duration 30s; requires "easing.hold"; requires "text.basic"; };
camera main { position (640,360); zoom 1; };
