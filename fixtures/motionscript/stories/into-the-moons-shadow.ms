// INTO THE MOON'S SHADOW
// 40 seconds. Stylised scientific plate. Ivory Sun, slate Moon, blue Earth.
// Sizes, distances and timing are exaggerated. Both plates share one moon path.
// 0:00 two viewpoints. 0:05 the shadow cone. 0:11 first contact.
// 0:21 totality, corona only while the bright disc is covered.
// 0:31 the left limb returns. 0:38 the right limb clears. Hold to 0:40.
// First contact is the sun's left limb and final contact is the right limb.
// The sliver at the end of totality is on the left again: a larger disc
// traveling one way uncovers the limb it first touched.
// Sound is not a channel. Quiet ambience, no travel whoosh.
// Soft ticks on the shadow labels. Small contact tones at 0:11, 0:21, 0:31, 0:38.
// The ambience thins through totality and resolves on the held last frame.
scene "into-the-moons-shadow" {
  version "0.2";
  viewport (1280, 720);
  background #0e141c;
  duration 40s;
  requires "easing.hold";
  requires "geometry.operators";
  requires "geometry.trimPath";
  requires "geometry.animatedTrim";
  requires "geometry.pathMorph";
  requires "paint.radialGradient";
  requires "text.basic";
};
camera main {
  position (620, 505.714);
  zoom 0.7;
  rotation 0deg;
};
group orbit {
  zIndex 2;
  group earth {
    position (880, 330);
    zIndex 1;
    circle air {
      radius 161;
      fill radial (0, 0) 161 0 #8ec8ee00 0.78 #8ec8ee00 0.9 #b7ddf240 1 #b7ddf200;
    };
    circle disc {
      radius 150;
      fill radial (-40, -6) 178 0 #c5e4f6 0.42 #3f86be 1 #142c48;
      stroke #d7ebf6 width 1.4;
    };
    ellipse landA { position (-40, -22); size (58, 32); fill #2f6d5888; };
    ellipse landB { position (-16, 34); size (44, 26); fill #3d7c6280; };
    ellipse landC { position (6, 4); size (24, 16); fill #24544666; };
    text name {
      content "Earth";
      fontFamily "sans";
      fontSize 26;
      fontWeight 600;
      align center;
      baseline bottom;
      fill #f4efe4;
      position (0, -168);
      opacity 0;
    };
  };
  path penumbra {
    opacity 0;
    zIndex 2;
    fill #9eb4cc47;
    move (570.854, 140.305); line (1663.158, -598.967); line (1663.158, 224.911); line (600.512, 235.366); close;
  };
  path umbra {
    opacity 0;
    zIndex 3;
    fill #0c1424d4;
    move (588.391, 132.681); line (1243.158, -17.284); line (619.272, 231.666); close;
  };
  path rayPenHi {
    zIndex 4;
    stroke #e7dcc488 width 1.55 cap round;
    move (180.445, 404.534); line (1663.158, -598.967);
  };
  path rayPenLo {
    zIndex 4;
    stroke #e7dcc488 width 1.55 cap round;
    move (129.115, 240.004); line (1663.158, 224.911);
  };
  path rayUmbraHi {
    zIndex 4;
    stroke #fff6e2cc width 1.55 cap round;
    move (109.907, 242.272); line (1243.158, -17.284);
  };
  path rayUmbraLo {
    zIndex 4;
    stroke #fff6e2cc width 1.55 cap round;
    move (163.355, 413.591); line (1243.158, -17.284);
  };
  group sun {
    position (130, 330);
    zIndex 5;
    ellipse glow {
      size (230, 230);
      fill radial (0, 0) 115 0 #f8e7c066 1 #f8e7c000;
    };
    circle disc {
      radius 90;
      fill radial (-16, -12) 98 0 #fff9ef 0.58 #f4d7a6 1 #e2b56c;
    };
    text name {
      content "Sun";
      fontFamily "sans";
      fontSize 26;
      fontWeight 600;
      align center;
      baseline bottom;
      fill #f4efe4;
      position (0, -108);
      opacity 0;
    };
  };
  group moon {
    position (600, 183.369);
    zIndex 6;
    circle disc {
      radius 52;
      fill radial (-8, -7) 56 0 #d5dde4 0.62 #7e8994 1 #3c4450;
      stroke #2a3138 width 1.2;
    };
    text name {
      content "Moon";
      fontFamily "sans";
      fontSize 26;
      fontWeight 600;
      align center;
      baseline bottom;
      fill #f4efe4;
      position (0, -68);
      opacity 0;
    };
  };
  path track {
    zIndex 7;
    opacity 0;
    stroke #f0c56e width 3.6 cap round;
    move (748, 282); line (748, 382);
  };
  group watcher {
    position (730, 330);
    zIndex 8;
    circle halo {
      radius 13;
      fill #ef7a3200;
      stroke #ef7a32 width 1.6;
      opacity 0;
    };
    circle dot {
      radius 5.4;
      fill #ef7a32;
      stroke #ffd3ae width 1.5;
    };
    text name {
      content "Observer";
      fontFamily "sans";
      fontSize 18;
      fontWeight 600;
      align left;
      baseline bottom;
      fill #f4efe4;
      position (16, 2);
      opacity 0;
    };
  };
  text umbraTag {
    content "Umbra: Sun fully hidden";
    fontFamily "sans";
    fontSize 18;
    fontWeight 600;
    align center;
    baseline middle;
    fill #f7f1e6;
    position (874, 98.644);
    opacity 0;
    zIndex 9;
  };
  text penumbraTag {
    content "Penumbra: Sun partly hidden";
    fontFamily "sans";
    fontSize 18;
    fontWeight 600;
    align center;
    baseline middle;
    fill #f7f1e6;
    position (922, 171.536);
    opacity 0;
    zIndex 9;
  };
};
group insetRoot {
  space screen;
  opacity 0;
  zIndex 7;
  rectangle frame {
    position (1092.487, 46);
    size (169.513, 164);
    fill #101820;
    stroke #d9cbb0 width 1.25;
  };
  group diagram {
    position (1098.2, 79.784);
    scale (0.143, 0.143);
    group earth {
    position (880, 330);
    zIndex 1;
    circle air {
      radius 161;
      fill radial (0, 0) 161 0 #8ec8ee00 0.78 #8ec8ee00 0.9 #b7ddf240 1 #b7ddf200;
    };
    circle disc {
      radius 150;
      fill radial (-40, -6) 178 0 #c5e4f6 0.42 #3f86be 1 #142c48;
      stroke #d7ebf6 width 1.4;
    };
    ellipse landA { position (-40, -22); size (58, 32); fill #2f6d5888; };
    ellipse landB { position (-16, 34); size (44, 26); fill #3d7c6280; };
    ellipse landC { position (6, 4); size (24, 16); fill #24544666; };
    
  };
  path penumbra {
    opacity 1;
    zIndex 2;
    fill #9eb4cc47;
    move (570.854, 140.305); line (1066, -194.81); line (1066, 230.787); line (600.512, 235.366); close;
  };
  path umbra {
    opacity 1;
    zIndex 3;
    fill #0c1424d4;
    move (588.391, 132.681); line (1066, 23.291); line (1066, 53.407); line (619.272, 231.666); close;
  };
  path rayPenHi {
    zIndex 4;
    stroke #e7dcc488 width 4.5 cap round;
    move (180.445, 404.534); line (1066, -194.81);
  };
  path rayPenLo {
    zIndex 4;
    stroke #e7dcc488 width 4.5 cap round;
    move (129.115, 240.004); line (1066, 230.787);
  };
  path rayUmbraHi {
    zIndex 4;
    stroke #fff6e2cc width 4.5 cap round;
    move (109.907, 242.272); line (1066, 23.291);
  };
  path rayUmbraLo {
    zIndex 4;
    stroke #fff6e2cc width 4.5 cap round;
    move (163.355, 413.591); line (1066, 53.407);
  };
  group sun {
    position (130, 330);
    zIndex 5;
    ellipse glow {
      size (230, 230);
      fill radial (0, 0) 115 0 #f8e7c066 1 #f8e7c000;
    };
    circle disc {
      radius 90;
      fill radial (-16, -12) 98 0 #fff9ef 0.58 #f4d7a6 1 #e2b56c;
    };
    
  };
  group moon {
    position (600, 183.369);
    zIndex 6;
    circle disc {
      radius 52;
      fill radial (-8, -7) 56 0 #d5dde4 0.62 #7e8994 1 #3c4450;
      stroke #2a3138 width 1.2;
    };
    
  };
  path track {
    zIndex 7;
    opacity 0;
    stroke #f0c56e width 3.6 cap round;
    move (748, 282); line (748, 382);
  };
  group watcher {
    position (730, 330);
    zIndex 8;
    circle halo {
      radius 13;
      fill #ef7a3200;
      stroke #ef7a32 width 1.6;
      opacity 0;
    };
    circle dot {
      radius 5.4;
      fill #ef7a32;
      stroke #ffd3ae width 1.5;
    };
    
  };
  };
};
group sky {
  space screen;
  zIndex 10;
  rectangle ground {
    position (0, 438);
    size (1280, 282);
    fill #12161c;
  };
  rectangle rule {
    position (0, 438);
    size (1280, 1.5);
    fill #cbbda6;
    zIndex 8;
  };
  group wash {
    opacity 0.62;
    zIndex 1;
    ellipse washWest {
      position (96, 640);
      size (210, 360);
      fill radial (0, 0) 170 0 #1b527a55 1 #1b527a00;
    };
    ellipse washEast {
      position (1184, 640);
      size (210, 360);
      fill radial (0, 0) 170 0 #1b527a55 1 #1b527a00;
    };
  };
  circle corona {
    position (640, 626);
    radius 148;
    fill radial (0, 0) 148 0 #fff8ef00 0.52 #fff8ef00 0.58 #fff6e6d0 0.68 #f0e2c07a 0.82 #e4d5ae33 1 #e4d5ae00;
    opacity 0;
    zIndex 2;
  };
  circle sun {
    position (640, 626);
    radius 60;
    fill #fff3d4;
    zIndex 3;
  };
  group mover {
    position (249.083, 626);
    zIndex 4;
    circle erase {
      radius 84;
      fill #12161c;
    };
    circle disc {
      radius 84;
      fill #07090d;
      opacity 0;
    };
  };
  text capOutside {
    content "Observer's sky — filtered view outside totality.";
    fontFamily "sans";
    fontSize 16;
    fontWeight 560;
    align left;
    baseline alphabetic;
    fill #f4efe4;
    position (36, 462);
    zIndex 6;
  };
  text capPartial {
    content "Partial eclipse.";
    fontFamily "sans";
    fontSize 18;
    fontWeight 650;
    align left;
    baseline alphabetic;
    fill #f4efe4;
    position (36, 462);
    opacity 0;
    zIndex 6;
  };
  text capTotal {
    content "Total eclipse.";
    fontFamily "sans";
    fontSize 18;
    fontWeight 650;
    align left;
    baseline alphabetic;
    fill #f4efe4;
    position (36, 462);
    opacity 0;
    zIndex 6;
  };
  text capEnded {
    content "Eclipse ended.";
    fontFamily "sans";
    fontSize 18;
    fontWeight 650;
    align left;
    baseline alphabetic;
    fill #f4efe4;
    position (36, 462);
    opacity 0;
    zIndex 6;
  };
  text capFiltered {
    content "Filtered view";
    fontFamily "sans";
    fontSize 14;
    fontWeight 500;
    align left;
    baseline alphabetic;
    fill #b7c4d0;
    position (36, 486);
    opacity 0;
    zIndex 6;
  };
  text capCorona {
    content "Corona shown during totality";
    fontFamily "sans";
    fontSize 14;
    fontWeight 500;
    align left;
    baseline alphabetic;
    fill #d9cbb6;
    position (36, 486);
    opacity 0;
    zIndex 6;
  };
};
group plate {
  space screen;
  zIndex 12;
  rectangle band {
    position (0, 0);
    size (1280, 36);
    fill #0e141c;
  };
  text disclaimer {
    content "Not to scale — sizes, distances and timing exaggerated";
    fontFamily "sans";
    fontSize 15;
    fontWeight 560;
    align center;
    baseline middle;
    fill #d9cbb6;
    position (640, 18);
  };
  text trackTag {
    content "Path of totality";
    fontFamily "sans";
    fontSize 16;
    fontWeight 600;
    align left;
    baseline bottom;
    fill #f0c56e;
    position (757.6, 216);
    opacity 0;
  };
  group explain {
    opacity 0;
    rectangle backing {
      position (28, 48);
      size (360, 64);
      fill #121820f2;
      stroke #d9cbb655 width 1;
    };
    text umbraLine {
      content "Inside umbra → total eclipse";
      fontFamily "sans";
      fontSize 15;
      fontWeight 600;
      align left;
      baseline alphabetic;
      fill #f4efe4;
      position (42, 74);
    };
    text penumbraLine {
      content "Inside penumbra → partial eclipse";
      fontFamily "sans";
      fontSize 15;
      fontWeight 600;
      align left;
      baseline alphabetic;
      fill #f4efe4;
      position (42, 98);
    };
  };
};
operators orbit.rayPenHi { trim 0, 0, 0; };
operators orbit.rayPenLo { trim 0, 0, 0; };
operators orbit.rayUmbraHi { trim 0, 0, 0; };
operators orbit.rayUmbraLo { trim 0, 0, 0; };
operators orbit.track { trim 0, 0, 0; };
operators insetRoot.diagram.track { trim 0, 0, 0; };
