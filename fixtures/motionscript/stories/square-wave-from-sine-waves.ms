keyframes axes.opacity {
  start 0s;
  duration 30s;
  0% 0 ease easeInOut;
  1.666667% 1 ease hold;
  100% 1;
};
keyframes lower.opacity {
  start 0s;
  duration 30s;
  0% 0 ease easeInOut;
  1.666667% 1 ease hold;
  72% 1 ease easeInOut;
  73.333333% 0 ease hold;
  100% 0;
};
keyframes cover.position.x {
  start 0s;
  duration 30s;
  0% 92 ease hold;
  1.666667% 92 ease linear;
  6.666667% 1192 ease hold;
  100% 1192;
};
step cover.visible { at 2000ms; value false; };
keyframes title.opacity {
  start 0s;
  duration 30s;
  0% 0 ease hold;
  0.666667% 0 ease easeInOut;
  3% 1 ease hold;
  10% 1 ease easeInOut;
  11.333333% 0 ease hold;
  100% 0;
};
keyframes c1.opacity {
  start 0s;
  duration 30s;
  0% 0 ease hold;
  3.333333% 0 ease easeInOut;
  3.666667% 1 ease hold;
  10.666667% 1 ease easeInOut;
  10.833333% 0 ease hold;
  100% 0;
};
keyframes c1.wave.trim.end {
  start 0s;
  duration 30s;
  0% 0 ease hold;
  3.333333% 0 ease easeInOut;
  6.666667% 1 ease hold;
  100% 1;
};
keyframes flyer.opacity {
  start 0s;
  duration 30s;
  0% 0 ease hold;
  10.666667% 0 ease easeInOut;
  10.833333% 1 ease hold;
  12% 1 ease easeInOut;
  13.166667% 0 ease hold;
  100% 0;
};
keyframes flyer.position {
  start 0s;
  duration 30s;
  0% (0, 0) ease hold;
  10.666667% (0, 0) ease easeInOut;
  13.166667% (-318, -438) ease hold;
  100% (-318, -438);
};
keyframes flyer.scale {
  start 0s;
  duration 30s;
  0% (1, 1) ease hold;
  10.666667% (1, 1) ease easeInOut;
  13.166667% (0.06, 0.12) ease hold;
  100% (0.06, 0.12);
};
keyframes eq.opacity {
  start 0s;
  duration 30s;
  0% 0 ease hold;
  12% 0 ease easeInOut;
  13.333333% 1 ease hold;
  100% 1;
};
step eq.pre1.visible { at 0ms; value true; };
