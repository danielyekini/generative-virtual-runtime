// COPPERLEAF RUN
// 30 seconds. Pip, a teal-hooded courier, runs a woodland ruin into a cavern.
// Art pixels are 320×180, each drawn as a 4×4 block. Poses, camera, and layers hold on whole art pixels.
// Mountains move at 1/4 camera speed, trees at 1/2, foreground grass at 9/8. No pose blending.
// Sound is not a MotionScript channel. Intended cues:
// woodland ambience until 0:25, then cave drips; the beat stays continuous
// light footfalls while Pip runs; jump chirps at 0:05.3, 0:11.4, 0:15.4, and 0:17.2
// coin notes at 0:02, 0:03, 0:04, along both early arcs, the three stepping-stone coins, and 0:29
// landing thud at 0:07.2, later landing taps, beetle ticks, checkpoint arpeggio at 0:21
scene "copperleaf-run" {
  version "0.2";
  viewport (1280, 720);
  background #7ec8f8;
  duration 30s;
  requires "easing.hold";
};
camera main {
  position (640, 360);
  zoom 1;
  rotation 0deg;
};
group far {
  position (0, 0);
  zIndex 0;
  rectangle sun { position (192, 72); size (56, 56); fill #ffe9a0; };
  rectangle sunCore { position (208, 88); size (24, 24); fill #fff6d4; };
    rectangle m0 { position (-152, 128); size (280, 184); fill #9eb4d0; };
    rectangle m0p { position (-80, 64); size (112, 72); fill #c5d4e6; };
    rectangle m1 { position (488, 96); size (280, 216); fill #7d97b8; };
    rectangle m1p { position (560, 32); size (112, 72); fill #a9bdd4; };
    rectangle m2 { position (1128, 64); size (280, 248); fill #9eb4d0; };
    rectangle m2p { position (1200, 0); size (112, 72); fill #c5d4e6; };
};
group mid {
  position (0, 0);
  zIndex 2;
    rectangle t0a { position (-88, 432); size (24, 112); fill #6b4428; };
    rectangle t0b { position (-128, 344); size (104, 88); fill #2f8a48; };
    rectangle t1a { position (712, 432); size (24, 112); fill #6b4428; };
    rectangle t1b { position (672, 344); size (104, 88); fill #2f8a48; };
    rectangle t2a { position (1512, 432); size (24, 112); fill #6b4428; };
    rectangle t2b { position (1472, 344); size (104, 88); fill #2f8a48; };
    rectangle t3a { position (2312, 432); size (24, 112); fill #6b4428; };
    rectangle t3b { position (2272, 344); size (104, 88); fill #2f8a48; };
};
