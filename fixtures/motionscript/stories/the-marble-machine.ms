circle triggerPin { position (990, 310); radius 8; fill #ae7246; stroke #fff5df width 3; };
// Clear-sided holding pocket; open at top and at its right-hand outlet.
rectangle pocketGlass { position (594, 352); size (94, 63); cornerRadius 5; fill #c7edf040; stroke #76b7be width 2; };
line pocketFloor { from (594, 398); to (706, 426); stroke #37b8b3 width 9 cap round; };
line pocketWall { from (594, 353); to (594, 398); stroke #76b7be width 4 cap round; };
path cord { move (1034, 363); line (674, 300); stroke #745b48 width 2; };
circle guideOne { position (1034, 363); radius 8; fill #ae7246; stroke #fff5df width 3; }; circle guideTwo { position (674, 300); radius 8; fill #ae7246; stroke #fff5df width 3; };
group cordLead { position (1034, 363); line lead { from (0, 0); to (0, -45); stroke #745b48 width 2 cap round; }; };
group cordEnd { position (674, 300); line tail { from (0, 0); to (0, 80); stroke #745b48 width 2 cap round; }; };
rectangle gate { position (670, 380); size (10, 35); cornerRadius 5; fill #d94b46; zIndex 4; };
line gateGuide { from (686, 330); to (686, 422); stroke #ae7246 width 3 cap round; };
path descent { move (706, 426); cubic (780, 458) (840, 518) (950.502525, 568.502525); stroke #37b8b3 width 12 cap round; };
group wheelOne { position (1000, 600); rotation 225deg;
 circle rim { position (0, 0); radius 70; fill #c6a9e5; stroke #8862be width 9; };
 line spoke0 { from (0, 0); to (70, 0); stroke #8862be width 10 cap round; }; group cup0 { position (70, 0); rotation -90deg; path lip { move (-19, -8); quadratic (-19, 17) (0, 17); quadratic (19, 17) (19, -8); stroke #ae7246 width 5 cap round; }; };
line spoke1 { from (0, 0); to (0, 70); stroke #8862be width 10 cap round; }; group cup1 { position (0, 70); rotation 0deg; path lip { move (-19, -8); quadratic (-19, 17) (0, 17); quadratic (19, 17) (19, -8); stroke #ae7246 width 5 cap round; }; };
