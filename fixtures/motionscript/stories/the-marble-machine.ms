group domino5 { position (840, 310); rectangle tile { position (-7, -60); size (14, 60); cornerRadius 5; fill #ee7769; stroke #cc584d width 2; }; circle pip { position (0, -41); radius 2; fill #fff5df;  }; circle pipTwo { position (0, -20); radius 2; fill #fff5df;  }; };
