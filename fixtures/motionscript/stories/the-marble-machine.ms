 };
 circle glint { position (-4, -5); radius 2.5; fill #ffffff;  };
};
group heading { space screen; zIndex 20; text title { position (640, 32); content "THE MARBLE MACHINE"; fontFamily "sans"; fontSize 22; fontWeight 600; align center; baseline middle; fill #654c3d; }; text subtitle { position (640, 58); content "ONE MARBLE  /  A WOODEN CHAIN REACTION"; fontFamily "sans"; fontSize 11; fontWeight 600; align center; baseline middle; fill #654c3d; }; };
group captions { space screen; zIndex 20; rectangle plate { position (95, 662); size (1090, 42); cornerRadius 5; fill #fffaf0;  };
 text cue0 { visible false; position (640, 683); content "01  RELEASE & ROLL   /   peg click · rising rolling rattle"; fontFamily "sans"; fontSize 15; fontWeight 600; align center; baseline middle; fill #654c3d; };
text cue1 { visible false; position (640, 683); content "02  TIP THE LEVER   /   hinge creak · rod click · bumper knock"; fontFamily "sans"; fontSize 15; fontWeight 600; align center; baseline middle; fill #654c3d; };
text cue2 { visible false; position (640, 683); content "03  DOMINO CHAIN   /   marble knock · eight wooden clacks · lever tap"; fontFamily "sans"; fontSize 15; fontWeight 600; align center; baseline middle; fill #654c3d; };
text cue3 { visible false; position (640, 683); content "04  OPEN THE GATE   /   cord twang · gate slide · rolling crescendo"; fontFamily "sans"; fontSize 15; fontWeight 600; align center; baseline middle; fill #654c3d; };
text cue4 { visible false; position (640, 683); content "05  TURN THE WHEELS   /   cup impacts · axle rattles · ticking"; fontFamily "sans"; fontSize 15; fontWeight 600; align center; baseline middle; fill #654c3d; };
text cue5 { visible false; position (640, 683); content "06  RACE TO THE FINISH   /   chatter becomes a circular rumble"; fontFamily "sans"; fontSize 15; fontWeight 600; align center; baseline middle; fill #654c3d; };
text cue6 { visible false; position (640, 683); content "07  COMPLETE   /   bowl click · bell · fading axle ticks"; fontFamily "sans"; fontSize 15; fontWeight 600; align center; baseline middle; fill #654c3d; };
};
