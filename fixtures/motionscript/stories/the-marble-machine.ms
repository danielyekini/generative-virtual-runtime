line stripe3 { from (0, 0); to (0, -22); stroke #fff5df width 5 cap round; };
 }; circle wheelOneAxle { position (1000, 600); radius 8; fill #ae7246; stroke #fff5df width 3; };
line wheelTransfer { from (1000, 688); to (1249.497475, 698.502525); stroke #37b8b3 width 12 cap round; };
