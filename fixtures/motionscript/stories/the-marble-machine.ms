// THE MARBLE MACHINE — 35 seconds. Authored mechanics; sound cues are captions.
scene "the-marble-machine" { version "0.2"; viewport (1280, 720); background #fff5df; duration 35s;
 requires "easing.hold"; requires "geometry.roundedRect"; requires "text.basic"; requires "paint.radialGradient"; };
camera main { position (800, 500); zoom 0.62; };
// Cream wooden backboard and restrained construction lines.
rectangle backboard { position (50, 40); size (1510, 940); cornerRadius 5; fill #f7e8ca; stroke #e0c79d width 4; };
line grain0 { from (130, 60); to (155, 960); stroke #efddba width 2 cap round; };
line grain1 { from (440, 60); to (465, 960); stroke #efddba width 2 cap round; };
line grain2 { from (750, 60); to (775, 960); stroke #efddba width 2 cap round; };
line grain3 { from (1060, 60); to (1085, 960); stroke #efddba width 2 cap round; };
line grain4 { from (1470, 60); to (1495, 960); stroke #efddba width 2 cap round; };
line startingRamp { from (80, 92); to (310, 210); stroke #37b8b3 width 12 cap round; };
rectangle peg { position (110, 70); size (10, 36); cornerRadius 5; fill #ae7246;  };
group seesaw { position (420, 210); rotation 0deg;
 rectangle beam { position (-130, -5); size (260, 10); cornerRadius 5; fill #f5c648;  };
 path cup { move (-131, -30); quadratic (-136, 0) (-110, 0); line (-89, 0); stroke #f5c648 width 6 cap round; };
};
polygon fulcrum { points ((403, 238), (437, 238), (420, 210)); fill #ae7246; };
circle seesawPin { position (420, 210); radius 8; fill #ae7246; stroke #fff5df width 3; };
rectangle bumper { position (300, 235); size (30, 13); cornerRadius 5; fill #ae7246;  };
group rod { position (520, 210); line shaft { from (0, 0); to (0, 60); stroke #ae7246 width 6 cap round; }; circle hinge { position (0, 0); radius 8; fill #ae7246; stroke #fff5df width 3; }; };
group stopper { rectangle block { position (306, 220); size (20, 13); cornerRadius 5; fill #dfaa77;  }; line link { from (320, 230); to (520, 290); stroke #ae7246 width 3 cap round; }; };
line exitRamp { from (547, 239); to (580, 310); stroke #37b8b3 width 12 cap round; };
line approach { from (570, 310); to (596, 310); stroke #37b8b3 width 12 cap round; };
line dominoBridge { from (638, 318); to (1000, 318); stroke #ae7246 width 12 cap round; };
group domino0 { position (600, 310); rectangle tile { position (-7, -60); size (14, 60); cornerRadius 5; fill #ee7769; stroke #cc584d width 2; }; circle pip { position (0, -41); radius 2; fill #fff5df;  }; circle pipTwo { position (0, -20); radius 2; fill #fff5df;  }; };
