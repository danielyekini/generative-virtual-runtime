# Dependencies, caches, build outputs
node_modules/
dist/
*.tsbuildinfo
.DS_Store
coverage/
.vite/
*.log
.turbo/
.cache/

# Archives / bulk transfer bundles
*.zip
evaluation.zip

# Harness scratch (not a historical evaluation record)
evaluation/evidence/

# Full frame captures, videos, image-diff collections, and failure samples.
# Keep them on disk under evidence/captures/ or evidence/failure-samples/; do not commit PNGs.
docs/evaluations/**/evidence/captures/
docs/evaluations/**/*.png
docs/evaluations/**/*.jpg
docs/evaluations/**/*.jpeg
docs/evaluations/**/*.webp
docs/evaluations/**/*.mp4
docs/evaluations/**/*.webm

# Large or redistribution-restricted corpus copies inside eval evidence.
# Fixture SHA-256 values live in manifest.json / loop.json.
docs/evaluations/**/evidence/sources/

# Large regenerated scene dumps (import/compile/diagnostic IR)
docs/evaluations/**/evidence/fixtures/**/compiled-scene.json
docs/evaluations/**/evidence/fixtures/**/imported-scene.json
docs/evaluations/**/evidence/fixtures/**/diagnostic-scene.json
docs/evaluations/**/evidence/fixtures/**/generated.motion

# Large source snapshots (full tree / patches). Keep hash manifests only.
docs/evaluations/**/source-snapshot/working-tree.patch
docs/evaluations/**/source-snapshot/tree/
docs/evaluations/**/source-snapshot/files/
